# Shared by web and worker
TOKEN_ENCRYPTION_KEY=          # openssl rand -base64 32
EMBED_API_KEY=                 # openssl rand -hex 24; web sends it to the worker's /embed

# Supabase (hosted project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # web server only: member invites, reading the source token
DATABASE_URL=                  # worker: direct Postgres connection as the postgres role

# Dropbox app (scoped, read-only: files.metadata.read files.content.read account_info.read)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:3000/api/dropbox/callback

# Object store: previews and uploaded files, under <lab_id>/ (Cloudflare R2 in the pilot)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=binary-labs-previews
PREVIEW_STORE=r2               # r2 | local
PREVIEW_DIR=                   # local only; relative to workers/, default .data/previews (web and worker share it)

# Worker
EMBED_URL=http://localhost:8787/embed
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDER=local                 # local: the model in this process | remote: chunks go to EMBED_URL's service
BINARY_ENV=                    # production: web and worker check every variable they need at startup

# Tests (local Homebrew Postgres)
TEST_DATABASE_URL=postgresql://localhost/binary_labs_test

# Labels (Tier 2/3)
ANTHROPIC_API_KEY=

# Speech-to-text for talk-throughs and procedure videos (Phase 2)
ELEVENLABS_API_KEY=
TRANSCRIBER=elevenlabs

# Procedure videos: posters and transcripts need ffmpeg on the worker host (optional; without it
# videos still play). R2 also needs a CORS rule on the bucket: PUT from the app origin, ETag exposed.
FFMPEG_PATH=ffmpeg
