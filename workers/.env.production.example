# The worker on Fly.io: secrets, set with `fly secrets set NAME=value ... --config workers/fly.toml`.
# BINARY_ENV, EMBEDDER, PREVIEW_STORE and TRANSCRIBER are set in fly.toml's [env] instead.
# docs/deploy.md says where each value comes from. With BINARY_ENV=production the worker
# stops at startup and lists any variable that's missing or malformed (config.py).

# Supabase > Connect > Session pooler (port 5432; Procrastinate needs a session, not the
# transaction pooler on 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# The same value as the web app's
TOKEN_ENCRYPTION_KEY=

# Modal: the same URL and key as the web app's
EMBED_URL=https://<workspace>--binary-embed.modal.run/embed
EMBED_API_KEY=

# Cloudflare R2: the same bucket and token as the web app's
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=binary-labs-previews

# Dropbox: the same app as the web app's, so the worker can refresh tokens
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Labels (Tier 2 and 3) and speech-to-text
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Model check: runs only when a key is set. One OpenRouter key covers every model; or set each
# provider's own key. MODEL_CHECK_MODELS is a comma list; the cap is per check, in US dollars.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MODEL_CHECK_MODELS=
MODEL_CHECK_GRADER=
MODEL_CHECK_COST_CAP_USD=
