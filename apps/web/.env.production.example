# The app (apps/web) on Vercel: Project > Settings > Environment Variables, Production.
# docs/deploy.md says where each value comes from. A production build stops and lists any
# variable that's missing or malformed (src/env.ts), so a half-set project never goes live.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The same value as the worker's: openssl rand -base64 32. Changing it locks out stored Dropbox tokens.
TOKEN_ENCRYPTION_KEY=

# Dropbox app console > your app > Settings
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=https://app.<domain>/api/dropbox/callback

# Cloudflare R2: the bucket and an Object Read & Write token scoped to it
PREVIEW_STORE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=binary-labs-previews

# Modal: the embedding service's URL plus /embed, and the key in its binary-embed secret
EMBED_URL=https://<workspace>--binary-embed.modal.run/embed
EMBED_API_KEY=

# Anthropic: asking the lab
ANTHROPIC_API_KEY=
